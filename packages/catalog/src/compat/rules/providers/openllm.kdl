// Provider-wire compat for "openllm". OpenLLM is a local gateway daemon
// (http://127.0.0.1:8787/v1) that fans requests out to the user's BYOK API
// providers and subscription plans through fallback chains (`ultra`, `plus`,
// `lite`). It proxies heterogeneous upstream models, so resolve.ts lists it in
// PROXY_OPENAI_COMPAT_PROVIDERS rather than treating it as a llama.cpp-style
// local backend. The daemon exposes a fixed low/medium/high reasoning-effort
// vocabulary; discovery gates `reasoning` on the /v1/models `capabilities`
// list, so non-reasoning entries never surface a ladder. priority=-1 so a
// class-lineage ladder wins equal-rank ties.

provider "openllm" priority=-1 {
	default-model "ultra"
	env "OPENLLM_API_KEY"
	discovery label="OpenLLM" allow-unauthenticated=#true

	thinking-efforts "low" "medium" "high"
}
